PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=filetodoc
DB_PASSWORD=filetodoc
DB_NAME=filetodoc
DB_SYNC=true

# Create a key at https://platform.claude.com/settings/keys
# Leave blank until you have one. Uploads fail with a clear error until this is set.
ANTHROPIC_API_KEY=

# Sonnet reads forms well. For cheaper high-volume extraction use claude-haiku-5-5.
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium
